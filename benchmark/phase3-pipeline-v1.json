{
  "schema": "aragorn/phase3-pipeline/v1",
  "stages": [
    {
      "id": "pipeline-unit",
      "description": "Verify the new local pipeline's fingerprint, skip, lock and refusal behavior; no historical product suite.",
      "tests": ["test_phase3_pipeline"],
      "inputs": [
        "scripts/phase3_pipeline.py",
        "tests/test_phase3_pipeline.py"
      ],
      "needs": [],
      "timeout_seconds": 120
    },
    {
      "id": "native-plugin-update-binding",
      "description": "Verify the new read-only native update observation/deployment binding using retained evidence, without Docker or a new capture.",
      "tests": ["test_native_phase3_plugin_update_binding"],
      "inputs": [
        "benchmark/evidence/phase3-native-plugin-update-systemd-development-v2-2026-10-01.json",
        "src/aragorn/__init__.py",
        "src/aragorn/cas.py",
        "src/aragorn/native_phase3_plugin_update_binding.py",
        "src/aragorn/oci_worker_protocol.py",
        "src/aragorn/phase3_deployment.py",
        "tests/test_native_phase3_plugin_update_binding.py"
      ],
      "needs": ["pipeline-unit"],
      "timeout_seconds": 120
    },
    {
      "id": "native-plugin-update-collection",
      "description": "Verify new exact-byte native observation retention and read-only independent replay; no live capture.",
      "tests": ["test_native_phase3_plugin_update_collection"],
      "inputs": [
        "benchmark/evidence/phase3-native-plugin-update-systemd-development-v2-2026-10-01.json",
        "src/aragorn/__init__.py",
        "src/aragorn/cas.py",
        "src/aragorn/native_phase3_plugin_update_binding.py",
        "src/aragorn/native_phase3_plugin_update_collection.py",
        "src/aragorn/oci_worker_protocol.py",
        "src/aragorn/phase3_deployment.py",
        "tests/test_native_phase3_plugin_update_collection.py"
      ],
      "needs": ["native-plugin-update-binding"],
      "timeout_seconds": 120
    },
    {
      "id": "native-plugin-update-collection-cli",
      "description": "Verify the new offline prepare/retain/replay CLI and bounded direct input reads.",
      "tests": ["test_native_plugin_update_collection_cli"],
      "inputs": [
        "benchmark/evidence/phase3-native-plugin-update-systemd-development-v2-2026-10-01.json",
        "scripts/native_plugin_update_collection.py",
        "src/aragorn/__init__.py",
        "src/aragorn/cas.py",
        "src/aragorn/native_phase3_plugin_update_binding.py",
        "src/aragorn/native_phase3_plugin_update_collection.py",
        "src/aragorn/oci_worker_protocol.py",
        "src/aragorn/phase3_deployment.py",
        "tests/test_native_plugin_update_collection_cli.py"
      ],
      "needs": ["native-plugin-update-collection"],
      "timeout_seconds": 120
    },
    {
      "id": "tetragon-loss-window",
      "description": "Verify the new bounded raw-scrape loss accounting and retained selected upstream source bytes; never infer zero from absence.",
      "tests": ["test_runtime_tetragon_loss"],
      "inputs": [
        "benchmark/evidence/tetragon-isolated-exec-exit-smoke-v1-2026-09-13.json",
        "benchmark/tetragon-candidate-source-v1.lock.json",
        "benchmark/tetragon-loss-source-v1.lock.json",
        "benchmark/tetragon-loss-source-v1/pkg/metrics/eventmetrics/bpfcollector.go",
        "benchmark/tetragon-loss-source-v1/pkg/metrics/eventmetrics/eventmetrics.go",
        "benchmark/tetragon-loss-source-v1/pkg/metrics/kprobemetrics/collector.go",
        "benchmark/tetragon-loss-source-v1/pkg/metrics/kprobemetrics/kprobemetrics.go",
        "benchmark/tetragon-loss-source-v1/pkg/metrics/kprobemetrics/missed.go",
        "benchmark/tetragon-loss-source-v1/pkg/metricsconfig/healthmetrics.go",
        "src/aragorn/__init__.py",
        "src/aragorn/oci_worker_protocol.py",
        "src/aragorn/runtime_tetragon_loss.py",
        "src/aragorn/runtime_tetragon_process.py",
        "tests/test_runtime_tetragon_loss.py"
      ],
      "needs": ["pipeline-unit"],
      "timeout_seconds": 120
    },
    {
      "id": "native-live-identity",
      "description": "Verify new read-only native process/file identity guards with controlled doubles; no service activation or live fixture.",
      "tests": ["test_native_phase3_live_identity"],
      "inputs": [
        "packaging/systemd/aragorn-agent-gateway.service",
        "packaging/systemd/aragorn-runtime-action-worker.service",
        "packaging/systemd/aragorn-runtime-lineage-capability-action-broker.service",
        "packaging/systemd/aragorn-runtime-lineage-capability-observation-publisher.service",
        "src/aragorn/__init__.py",
        "src/aragorn/native_phase3_live_identity.py",
        "src/aragorn/oci_worker_protocol.py",
        "src/aragorn/runtime_action_broker.py",
        "src/aragorn/runtime_action_decision.py",
        "src/aragorn/runtime_action_observation_publisher.py",
        "src/aragorn/runtime_process_profile.py",
        "tests/test_native_phase3_live_identity.py"
      ],
      "needs": ["pipeline-unit"],
      "timeout_seconds": 120
    },
    {
      "id": "tetragon-stats-map",
      "description": "Verify the new fixed read-only BPF syscall/map contract, bounded per-CPU decoding, continuity guards and selected source custody; no actual BPF operations.",
      "tests": ["test_runtime_tetragon_stats_map"],
      "inputs": [
        "benchmark/tetragon-stats-map-source-v1.lock.json",
        "benchmark/tetragon-stats-map-source-v1/bpf/lib/process.h",
        "benchmark/tetragon-stats-map-source-v1/linux-v6.8-abi-excerpts.json",
        "benchmark/tetragon-stats-map-source-v1/pkg/api/processapi/processapi.go",
        "src/aragorn/__init__.py",
        "src/aragorn/runtime_tetragon_stats_map.py",
        "tests/test_runtime_tetragon_stats_map.py"
      ],
      "needs": ["pipeline-unit"],
      "timeout_seconds": 120
    }
  ]
}
