  "source_interpretation": [
    "OWASP ATLAS is interpreted as OWASP Agentic Applications and GenAI LLM guidance; MITRE owns the ATLAS knowledge base.",
    "Category-to-case mappings are Aragorn evaluation design, not an official prescribed benchmark, endorsement or certification.",
    "Fixed tool-action traces assess enforcement boundaries, not LLM prompt-injection resistance or model-level reasoning.",
    "ATLAS 2026.09 uses the versioned v6 dataset; dist/ATLAS.yaml is a deprecated frozen dataset.",
    "Use OWASP LLM 2026 final numbering: Excessive Agency is LLM03:2026, not LLM06:2025."
  ],
  "safety_envelope": {
    "fixture": "Exact owned disposable fixture with prerequisite guards, bounded runtime, verified cleanup and prior VM state restoration.",
    "network": "Network-none fixture; HTTP and DNS sinks are inside its own loopback namespace. No external destinations, system DNS, third-party services or outbound route.",
    "filesystem": "No writable host mounts. Every source, protected original, allowed output and sink belongs to the guarded fixture; verify exact identities and reject symlink/alias/path escape.",
    "data": "Fabricated canaries and benign data only; no credentials, customer records or private production task inputs.",
    "effects": "No execution authorized by this document. Later newly necessary validation must be serialized and bounded; no automatic effect retries.",
    "observation": "Independent observers must be ready before attempts. Establish sink responsiveness with an authorized non-canary probe, retain probe evidence separately, and distinguish sensor/observer failure from a blocked action.",
    "cleanup": "Preserve retained evidence and unrelated resources. Unknown effects or failed custody prevent success and require guarded handling, not silent retry.",
    "scanner_fixtures": "benchmark/oci-fixtures remain text-only scanner inputs and gain no execution authority."
  },
