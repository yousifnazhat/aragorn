[Unit]
Description=Aragorn isolated OpenClaw agent gateway
After=local-fs.target nss-user-lookup.target aragorn-runtime-action-worker.service
Requires=aragorn-runtime-action-worker.service
ConditionPathExists=/usr/local/bin/node
ConditionPathExists=/runtime/lib/node_modules/openclaw/openclaw.mjs
ConditionPathExists=/etc/aragorn/agent-gateway/openclaw.json
ConditionPathExists=/etc/aragorn/agent-gateway/environment
ConditionPathExists=/usr/lib/aragorn/openclaw/aragorn-runtime-action-worker/openclaw.plugin.json
ConditionPathExists=/usr/lib/aragorn/openclaw/aragorn-runtime-action-worker/index.js
ConditionPathExists=/var/lib/aragorn-agent-gateway/home
ConditionPathExists=/var/lib/aragorn-agent-gateway/state
ConditionPathExists=/var/lib/aragorn-agent-gateway/workspace

[Service]
Type=simple
User=aragorn-agent-gateway
Group=aragorn-agent-gateway
SupplementaryGroups=
LoadCredential=openclaw-config:/etc/aragorn/agent-gateway/openclaw.json
EnvironmentFile=/etc/aragorn/agent-gateway/environment
ExecStart=/usr/local/bin/node /runtime/lib/node_modules/openclaw/openclaw.mjs gateway run --auth token --bind loopback --port 18789 --tailscale off
WorkingDirectory=/var/lib/aragorn-agent-gateway/workspace
Environment=HOME=/var/lib/aragorn-agent-gateway/home LANG=C LC_ALL=C NO_COLOR=1 NO_PROXY=127.0.0.1,localhost OPENCLAW_CONFIG_PATH=%d/openclaw-config OPENCLAW_STATE_DIR=/var/lib/aragorn-agent-gateway/state PATH=/usr/local/bin:/usr/bin:/bin TZ=UTC
UMask=0077
TimeoutStartSec=30s
TimeoutStopSec=10s
KillMode=control-group
KillSignal=SIGTERM
TasksMax=128
MemoryMax=1G
MemorySwapMax=0
LimitNOFILE=256
OOMPolicy=stop
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aragorn-agent-gateway

NoNewPrivileges=yes
AmbientCapabilities=
CapabilityBoundingSet=
Delegate=no
PrivateDevices=yes
PrivateIPC=yes
PrivateMounts=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadWritePaths=/var/lib/aragorn-agent-gateway
ReadOnlyPaths=/usr/lib/aragorn/openclaw/aragorn-runtime-action-worker /runtime /run/aragorn-runtime-action-worker
ReadOnlyPaths=-/opt/aragorn/runtime-profile
InaccessiblePaths=/etc/aragorn/agent-gateway
InaccessiblePaths=/etc/aragorn/runtime-action-worker.json /etc/aragorn/runtime-action-runtime.json /etc/aragorn/runtime-action-observation.json /etc/aragorn/runtime-capability-grant.json /etc/aragorn/runtime-action-revocation-publication.json
InaccessiblePaths=/var/lib/aragorn-runtime-action /var/lib/aragorn-protected /run/aragorn-runtime-observation
InaccessiblePaths=-/etc/aragorn/openclaw-profile -/var/lib/aragorn-openclaw-profile -/opt/aragorn/openclaw/aragorn-runtime-action
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
KeyringMode=private
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=~@mount @reboot @swap @raw-io @clock ptrace process_vm_readv process_vm_writev kcmp
