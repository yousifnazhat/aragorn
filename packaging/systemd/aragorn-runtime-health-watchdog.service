[Unit]
Description=Aragorn accepted-health expiry response for the fixed runtime profile
After=local-fs.target nss-user-lookup.target
RequiresMountsFor=/var/lib/aragorn-runtime-action/control /var/lib/aragorn-runtime-response
RefuseManualStart=yes
# The fixed one-second timer must keep retrying after lock contention/refusal.
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=no
User=root
Group=root
ExecStart=/usr/bin/python3.12 -I -S -B /usr/libexec/aragorn/aragorn-runtime-health-watchdog.py
WorkingDirectory=/
Environment=HOME=/nonexistent LANG=C LC_ALL=C PATH=/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 TZ=UTC
UMask=0077
TimeoutStartSec=45s
TasksMax=8
MemoryMax=128M
MemorySwapMax=0
LimitNOFILE=64
OOMPolicy=stop
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aragorn-runtime-health-watchdog
NoNewPrivileges=yes
AmbientCapabilities=
CapabilityBoundingSet=CAP_DAC_OVERRIDE
Delegate=no
PrivateDevices=yes
PrivateIPC=yes
PrivateMounts=yes
BindPaths=-/run/credentials/aragorn-runtime-action-worker.service:/run/aragorn-runtime-response-worker-credential
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=default
ProtectSystem=strict
ProcSubset=pid
ReadWritePaths=/var/lib/aragorn-runtime-action/control /var/lib/aragorn-runtime-response /run/lock /etc/systemd/system
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
KeyringMode=private
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=~@mount @reboot @swap @raw-io @clock
