{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aragorn.dev/schema/admission-artifact-graph-v4.schema.json",
  "title": "Aragorn recursive GitHub admission artifact graph with retained release assets v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "verifier",
    "profile",
    "root_manifest_digest",
    "root_github_manifest_digest",
    "source_proof_digest",
    "quarantine_receipt_digest",
    "gateway_profile_digest",
    "expansion_digest",
    "expansion_proof_digest",
    "tree_digest",
    "artifacts",
    "edges",
    "coverage",
    "closure"
  ],
  "properties": {
    "schema": {"const": "aragorn/admission-artifact-graph/v4"},
    "authority": {"const": "CLOSURE_EVIDENCE_ONLY_NOT_INSTALLER_AUTHORITY"},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "implementation_digest"],
      "properties": {
        "name": {"const": "aragorn/admission-artifact-graph-verifier"},
        "version": {"const": "4"},
        "implementation_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "profile": {"const": "recursive-github-markdown/v2"},
    "root_manifest_digest": {"$ref": "#/$defs/digest"},
    "root_github_manifest_digest": {"$ref": "#/$defs/digest"},
    "source_proof_digest": {"$ref": "#/$defs/digest"},
    "quarantine_receipt_digest": {"$ref": "#/$defs/digest"},
    "gateway_profile_digest": {"$ref": "#/$defs/digest"},
    "expansion_digest": {"$ref": "#/$defs/digest"},
    "expansion_proof_digest": {
      "oneOf": [
        {"$ref": "#/$defs/digest"},
        {"type": "null"}
      ]
    },
    "tree_digest": {"$ref": "#/$defs/digest"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "$ref": "https://aragorn.dev/schema/source-artifact-graph-v1.schema.json#/$defs/edge"
          },
          {"$ref": "#/$defs/release_asset_edge"}
        ]
      },
      "contains": {"$ref": "#/$defs/release_asset_edge"},
      "minContains": 1
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statically_resolvable", "unresolved_required"],
      "properties": {
        "statically_resolvable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["captured", "total"],
          "properties": {
            "captured": {"type": "integer", "minimum": 0, "maximum": 10000},
            "total": {"type": "integer", "minimum": 1, "maximum": 10000}
          }
        },
        "unresolved_required": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "profile", "status", "unresolved"],
      "properties": {
        "scope": {"const": "artifact_graph"},
        "profile": {"const": "recursive-github-markdown/v2"},
        "status": {"enum": ["complete", "incomplete"]},
        "unresolved": {
          "type": "array",
          "minItems": 0,
          "maxItems": 30000,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 4352}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "complete"}},
            "required": ["status"]
          },
          "then": {"properties": {"unresolved": {"maxItems": 0}}},
          "else": {"properties": {"unresolved": {"minItems": 1}}}
        }
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001f\\u007f])(?!.*\\\\)(?!.*//)(?!(?:\\.|\\.\\.)(?:/|$))(?!.*\\/(?:\\.|\\.\\.)(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "digest", "executable"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "size": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "digest": {"$ref": "#/$defs/digest"},
        "executable": {"type": "boolean"}
      }
    },
    "release_asset_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "url",
        "release_id",
        "asset_id",
        "digest",
        "github_digest",
        "result_digest"
      ],
      "properties": {
        "kind": {"const": "github_release_asset"},
        "url": {
          "type": "string",
          "pattern": "^https://github[.]com/[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/[a-z0-9_.-]{1,100}/releases/download/[A-Za-z0-9][A-Za-z0-9._-]{0,254}/[A-Za-z0-9][A-Za-z0-9._-]{0,254}$"
        },
        "release_id": {"type": "integer", "minimum": 1},
        "asset_id": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "github_digest": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "result_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "release_asset_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "source_blob_digest",
        "byte_offset",
        "literal_digest",
        "reference_kind",
        "status",
        "literal",
        "target",
        "reason_code"
      ],
      "properties": {
        "source_path": {"$ref": "#/$defs/path"},
        "source_blob_digest": {"$ref": "#/$defs/digest"},
        "byte_offset": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "literal_digest": {"$ref": "#/$defs/digest"},
        "reference_kind": {"const": "github_release_asset"},
        "status": {"const": "unresolved"},
        "literal": {
          "type": "string",
          "pattern": "^https://github[.]com/[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/[a-z0-9_.-]{1,100}/releases/download/[A-Za-z0-9][A-Za-z0-9._-]{0,254}/[A-Za-z0-9][A-Za-z0-9._-]{0,254}$"
        },
        "target": {
          "oneOf": [
            {"$ref": "#/$defs/release_asset_target"},
            {"type": "null"}
          ]
        },
        "reason_code": {
          "enum": [
            "ARCHIVE_INVENTORY_UNSUPPORTED",
            "GITHUB_RELEASE_ASSET_DIGEST_UNAVAILABLE",
            "GITHUB_RELEASE_ASSET_NOT_ANALYZED",
            "GITHUB_RELEASE_ASSET_NOT_RETAINED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason_code": {
                "const": "GITHUB_RELEASE_ASSET_NOT_RETAINED"
              }
            },
            "required": ["reason_code"]
          },
          "then": {"properties": {"target": {"type": "null"}}}
        },
        {
          "if": {
            "properties": {
              "reason_code": {
                "const": "GITHUB_RELEASE_ASSET_NOT_ANALYZED"
              }
            },
            "required": ["reason_code"]
          },
          "then": {
            "properties": {
              "target": {
                "allOf": [
                  {"$ref": "#/$defs/release_asset_target"},
                  {
                    "properties": {
                      "github_digest": {"$ref": "#/$defs/digest"}
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason_code": {
                "const": "GITHUB_RELEASE_ASSET_DIGEST_UNAVAILABLE"
              }
            },
            "required": ["reason_code"]
          },
          "then": {
            "properties": {
              "target": {
                "allOf": [
                  {"$ref": "#/$defs/release_asset_target"},
                  {
                    "properties": {
                      "github_digest": {"type": "null"}
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason_code": {"const": "ARCHIVE_INVENTORY_UNSUPPORTED"}
            },
            "required": ["reason_code"]
          },
          "then": {
            "properties": {
              "target": {"$ref": "#/$defs/release_asset_target"}
            }
          }
        }
      ]
    }
  }
}
