{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn analyzer configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "analyzers"],
  "properties": {
    "schema": {"const": "aragorn/analyzers/v1"},
    "analyzers": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "argv"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(?:\\S|\\S[^\\r\\n]*\\S)$",
            "maxLength": 256
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]+$"
            }
          }
        }
      }
    }
  }
}
