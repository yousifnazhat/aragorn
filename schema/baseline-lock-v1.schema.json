{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn Phase 0 baseline closure-candidate lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "observed_at", "baselines"],
  "properties": {
    "schema": {"const": "aragorn/baseline-lock/v1"},
    "observed_at": {"type": "string", "format": "date"},
    "baselines": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "repository",
          "commit",
          "release",
          "license",
          "distribution",
          "profile",
          "build",
          "image",
          "runtime_profile",
          "attestation_status"
        ],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "version": {"type": "string", "minLength": 1, "maxLength": 256},
          "repository": {"type": "string", "format": "uri"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "release": {
            "anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
          },
          "license": {"const": "Apache-2.0"},
          "distribution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "package", "sha256"],
            "properties": {
              "kind": {"enum": ["pypi-wheel", "git-source"]},
              "package": {
                "anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
              },
              "sha256": {
                "anyOf": [{"$ref": "#/$defs/hex_digest"}, {"type": "null"}]
              }
            }
          },
          "profile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "network", "arguments", "environment", "disabled_features"],
            "properties": {
              "mode": {"const": "local-static"},
              "network": {"const": "deny"},
              "arguments": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "environment": {
                "type": "object",
                "additionalProperties": {"type": "string"}
              },
              "disabled_features": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              }
            }
          },
          "build": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dockerfile_sha256",
              "build_input_sha256",
              "dependency_lock_sha256",
              "frontend_digest",
              "python_image_digest",
              "uv_image_digest",
              "artifacts"
            ],
            "properties": {
              "dockerfile_sha256": {"$ref": "#/$defs/hex_digest"},
              "build_input_sha256": {"$ref": "#/$defs/hex_digest"},
              "dependency_lock_sha256": {"$ref": "#/$defs/hex_digest"},
              "frontend_digest": {"$ref": "#/$defs/digest"},
              "python_image_digest": {"$ref": "#/$defs/digest"},
              "uv_image_digest": {"$ref": "#/$defs/digest"},
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "sha256"],
                  "properties": {
                    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
                    "sha256": {"$ref": "#/$defs/hex_digest"}
                  }
                },
                "uniqueItems": true
              }
            }
          },
          "image": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "local_tag",
              "index_digest",
              "platform_manifest_digest",
              "config_digest",
              "build_provenance_manifest_digest",
              "os",
              "architecture",
              "size_bytes"
            ],
            "properties": {
              "local_tag": {"type": "string", "minLength": 1},
              "index_digest": {"$ref": "#/$defs/digest"},
              "platform_manifest_digest": {"$ref": "#/$defs/digest"},
              "config_digest": {"$ref": "#/$defs/digest"},
              "build_provenance_manifest_digest": {"$ref": "#/$defs/digest"},
              "os": {"const": "linux"},
              "architecture": {"enum": ["arm64", "amd64"]},
              "size_bytes": {"type": "integer", "minimum": 1}
            }
          },
          "runtime_profile": {"$ref": "#/$defs/runtime_profile"},
          "attestation_status": {
            "const": "oci_closure_candidate_runner_attestation_pending"
          }
        }
      }
    }
  },
  "$defs": {
    "hex_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runtime_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "pull",
        "network",
        "read_only_rootfs",
        "cap_drop",
        "no_new_privileges",
        "user",
        "workdir",
        "pids_limit",
        "memory_bytes",
        "memory_swap_bytes",
        "cpus",
        "nofile_soft",
        "nofile_hard",
        "tmpfs",
        "workspace"
      ],
      "properties": {
        "engine": {"const": "docker"},
        "pull": {"const": "never"},
        "network": {"const": "none"},
        "read_only_rootfs": {"const": true},
        "cap_drop": {"const": ["ALL"]},
        "no_new_privileges": {"const": true},
        "user": {"const": "65532:65532"},
        "workdir": {"const": "/opt/aragorn-control"},
        "pids_limit": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "memory_swap_bytes": {"type": "integer", "minimum": 1},
        "cpus": {"type": "number", "exclusiveMinimum": 0},
        "nofile_soft": {"type": "integer", "minimum": 1},
        "nofile_hard": {"type": "integer", "minimum": 1},
        "tmpfs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["destination", "size_bytes", "options"],
          "properties": {
            "destination": {"const": "/tmp"},
            "size_bytes": {"type": "integer", "minimum": 1},
            "options": {"const": ["rw", "noexec", "nosuid", "nodev", "mode=1777"]}
          }
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["destination", "read_only"],
          "properties": {
            "destination": {"const": "/workspace"},
            "read_only": {"const": true}
          }
        }
      }
    }
  }
}
