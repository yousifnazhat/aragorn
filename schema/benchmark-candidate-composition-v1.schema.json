{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn derived comparative benchmark candidate composition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assurance",
    "suite_digest",
    "dispatch_digest",
    "policy_digest",
    "outcomes_digest",
    "outcomes"
  ],
  "properties": {
    "schema": {"const": "aragorn/benchmark-candidate-composition/v1"},
    "assurance": {
      "const": "derived_from_authenticated_comparator_evidence_not_hardware_attested"
    },
    "suite_digest": {"$ref": "#/$defs/digest"},
    "dispatch_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "outcomes_digest": {"$ref": "#/$defs/digest"},
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/outcome"}
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "reason": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:\\S|\\S[^\\r\\n]*\\S)$",
      "maxLength": 256
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "implementation_digest",
        "config_digest"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/version"},
        "implementation_digest": {"$ref": "#/$defs/digest"},
        "config_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "suite_digest",
        "case_id",
        "tree_digest",
        "run_id",
        "system",
        "evidence_digest",
        "verdict",
        "reason_codes"
      ],
      "properties": {
        "schema": {"const": "aragorn/benchmark-outcome/v1"},
        "suite_digest": {"$ref": "#/$defs/digest"},
        "case_id": {"$ref": "#/$defs/id"},
        "tree_digest": {"$ref": "#/$defs/digest"},
        "run_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "system": {"$ref": "#/$defs/system"},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "verdict": {"enum": ["ALLOW", "REVIEW", "DENY", "ERROR"]},
        "reason_codes": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reason"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"verdict": {"const": "ALLOW"}}},
          "then": {"properties": {"reason_codes": {"maxItems": 0}}},
          "else": {"properties": {"reason_codes": {"minItems": 1}}}
        }
      ]
    }
  }
}
