{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn unsigned label-free benchmark collection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assurance",
    "ledger_id",
    "suite_digest",
    "dispatch_digest",
    "outcomes_digest",
    "report_digest",
    "jobs"
  ],
  "properties": {
    "schema": {"const": "aragorn/benchmark-collection/v1"},
    "assurance": {"const": "unsigned_label_free_protocol_not_isolated_or_attested"},
    "ledger_id": {"$ref": "#/$defs/digest"},
    "suite_digest": {"$ref": "#/$defs/digest"},
    "dispatch_digest": {"$ref": "#/$defs/digest"},
    "outcomes_digest": {"$ref": "#/$defs/digest"},
    "report_digest": {"$ref": "#/$defs/digest"},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job_id",
          "request_digest",
          "result_digest",
          "output_closure_digest",
          "nonce_receipt_digest",
          "nested_evidence_digest",
          "evidence_digest"
        ],
        "properties": {
          "job_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
          "request_digest": {"$ref": "#/$defs/digest"},
          "result_digest": {"$ref": "#/$defs/digest"},
          "output_closure_digest": {"$ref": "#/$defs/digest"},
          "nonce_receipt_digest": {"$ref": "#/$defs/digest"},
          "nested_evidence_digest": {"$ref": "#/$defs/digest"},
          "evidence_digest": {"$ref": "#/$defs/digest"}
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
