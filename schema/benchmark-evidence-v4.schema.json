{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn collected unsigned label-free OCI benchmark evidence v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "suite_digest",
    "case_id",
    "tree_digest",
    "run_id",
    "system",
    "verdict",
    "reason_codes",
    "nested_evidence_digest",
    "worker"
  ],
  "properties": {
    "schema": {"const": "aragorn/benchmark-evidence/v4"},
    "suite_digest": {"$ref": "#/$defs/digest"},
    "case_id": {"$ref": "#/$defs/id"},
    "tree_digest": {"$ref": "#/$defs/digest"},
    "run_id": {"type": "integer", "minimum": 1, "maximum": 10},
    "system": {"$ref": "#/$defs/system"},
    "verdict": {"enum": ["ALLOW", "REVIEW", "DENY", "ERROR"]},
    "reason_codes": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
      }
    },
    "nested_evidence_digest": {"$ref": "#/$defs/digest"},
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assurance",
        "ledger_id",
        "dispatch_digest",
        "job_id",
        "nonce",
        "request_digest",
        "result_digest",
        "subject_manifest_digest",
        "output_closure_digest",
        "nonce_receipt_digest"
      ],
      "properties": {
        "assurance": {"const": "unsigned_label_free_protocol_not_isolated_or_attested"},
        "ledger_id": {"$ref": "#/$defs/digest"},
        "dispatch_digest": {"$ref": "#/$defs/digest"},
        "job_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "request_digest": {"$ref": "#/$defs/digest"},
        "result_digest": {"$ref": "#/$defs/digest"},
        "subject_manifest_digest": {"$ref": "#/$defs/digest"},
        "output_closure_digest": {"$ref": "#/$defs/digest"},
        "nonce_receipt_digest": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "ALLOW"}}},
      "then": {"properties": {"reason_codes": {"maxItems": 0}}},
      "else": {"properties": {"reason_codes": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "implementation_digest", "config_digest"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "minLength": 1, "maxLength": 256},
        "implementation_digest": {"$ref": "#/$defs/digest"},
        "config_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
