{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn effective OCI benchmark system configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "version",
    "baseline_lock_digest",
    "baseline_entry_digest",
    "docker_executable_digest",
    "runner_identity",
    "image",
    "entrypoint",
    "arguments",
    "environment",
    "runtime_profile",
    "limits",
    "normalization"
  ],
  "properties": {
    "schema": {"const": "aragorn/benchmark-oci-system-config/v2"},
    "name": {"$ref": "#/$defs/id"},
    "version": {
      "type": "string",
      "pattern": "^(?:\\S|\\S[^\\r\\n]*\\S)$",
      "maxLength": 256
    },
    "baseline_lock_digest": {"$ref": "#/$defs/digest"},
    "baseline_entry_digest": {"$ref": "#/$defs/digest"},
    "docker_executable_digest": {"$ref": "#/$defs/digest"},
    "runner_identity": {"$ref": "#/$defs/runner_identity"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "index_digest",
        "platform_manifest_digest",
        "config_digest",
        "os",
        "architecture",
        "size_bytes"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$",
          "maxLength": 1024
        },
        "index_digest": {"$ref": "#/$defs/digest"},
        "platform_manifest_digest": {"$ref": "#/$defs/digest"},
        "config_digest": {"$ref": "#/$defs/digest"},
        "os": {"const": "linux"},
        "architecture": {"enum": ["arm64", "amd64"]},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "entrypoint": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "arguments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "environment": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "additionalProperties": {"type": "string", "maxLength": 16384}
    },
    "runtime_profile": {"$ref": "#/$defs/runtime_profile"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "output_bytes"],
      "properties": {
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    },
    "normalization": {
      "enum": [
        "cisco-ai-skill-scanner-2.0.12/v1",
        "nvidia-skillspector-2.4.3/v1"
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "runner_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assurance", "context", "engine", "worker_claim"],
      "properties": {
        "assurance": {"const": "docker_daemon_self_report_not_attested"},
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "endpoint",
            "skip_tls_verify",
            "tls_material_count"
          ],
          "properties": {
            "name": {"$ref": "#/$defs/nonempty_string"},
            "endpoint": {"$ref": "#/$defs/nonempty_string"},
            "skip_tls_verify": {"const": false},
            "tls_material_count": {"const": 0}
          }
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform_name",
            "version",
            "api_version",
            "minimum_api_version",
            "git_commit",
            "go_version",
            "os",
            "architecture",
            "kernel_version",
            "build_time",
            "components"
          ],
          "properties": {
            "platform_name": {"$ref": "#/$defs/nonempty_string"},
            "version": {"$ref": "#/$defs/nonempty_string"},
            "api_version": {"$ref": "#/$defs/nonempty_string"},
            "minimum_api_version": {"$ref": "#/$defs/nonempty_string"},
            "git_commit": {"$ref": "#/$defs/nonempty_string"},
            "go_version": {"$ref": "#/$defs/nonempty_string"},
            "os": {"const": "linux"},
            "architecture": {"enum": ["arm64", "amd64"]},
            "kernel_version": {"$ref": "#/$defs/nonempty_string"},
            "build_time": {"$ref": "#/$defs/nonempty_string"},
            "components": {
              "type": "array",
              "minItems": 3,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "version", "git_commit"],
                "properties": {
                  "name": {"$ref": "#/$defs/nonempty_string"},
                  "version": {"$ref": "#/$defs/nonempty_string"},
                  "git_commit": {"$ref": "#/$defs/nonempty_string"}
                }
              }
            }
          }
        },
        "worker_claim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "daemon_id",
            "daemon_name",
            "server_version",
            "operating_system",
            "os",
            "architecture",
            "kernel_version",
            "security_options",
            "cgroup_version",
            "default_runtime",
            "storage_driver"
          ],
          "properties": {
            "daemon_id": {"$ref": "#/$defs/nonempty_string"},
            "daemon_name": {"$ref": "#/$defs/nonempty_string"},
            "server_version": {"$ref": "#/$defs/nonempty_string"},
            "operating_system": {"$ref": "#/$defs/nonempty_string"},
            "os": {"const": "linux"},
            "architecture": {"enum": ["arm64", "amd64"]},
            "kernel_version": {"$ref": "#/$defs/nonempty_string"},
            "security_options": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/nonempty_string"}
            },
            "cgroup_version": {"$ref": "#/$defs/nonempty_string"},
            "default_runtime": {"$ref": "#/$defs/nonempty_string"},
            "storage_driver": {"$ref": "#/$defs/nonempty_string"}
          }
        }
      }
    },
    "runtime_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "pull",
        "network",
        "read_only_rootfs",
        "cap_drop",
        "no_new_privileges",
        "user",
        "workdir",
        "pids_limit",
        "memory_bytes",
        "memory_swap_bytes",
        "cpus",
        "nofile_soft",
        "nofile_hard",
        "tmpfs",
        "workspace"
      ],
      "properties": {
        "engine": {"const": "docker"},
        "pull": {"const": "never"},
        "network": {"const": "none"},
        "read_only_rootfs": {"const": true},
        "cap_drop": {"const": ["ALL"]},
        "no_new_privileges": {"const": true},
        "user": {"const": "65532:65532"},
        "workdir": {"const": "/opt/aragorn-control"},
        "pids_limit": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "memory_swap_bytes": {"type": "integer", "minimum": 1},
        "cpus": {"type": "number", "exclusiveMinimum": 0},
        "nofile_soft": {"type": "integer", "minimum": 1},
        "nofile_hard": {"type": "integer", "minimum": 1},
        "tmpfs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["destination", "size_bytes", "options"],
          "properties": {
            "destination": {"const": "/tmp"},
            "size_bytes": {"type": "integer", "minimum": 1},
            "options": {"const": ["rw", "noexec", "nosuid", "nodev", "mode=1777"]}
          }
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["destination", "read_only"],
          "properties": {
            "destination": {"const": "/workspace"},
            "read_only": {"const": true}
          }
        }
      }
    }
  }
}
