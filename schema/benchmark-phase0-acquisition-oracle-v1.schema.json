{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aragorn.dev/schema/benchmark-phase0-acquisition-oracle-v1.schema.json",
  "title": "Aragorn Phase 0 private acquisition/reference oracle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "root_suite_digest",
    "expanded_suite_digest",
    "split",
    "runs_per_case",
    "candidate_system",
    "comparators",
    "expansion_profile",
    "budgets",
    "cases"
  ],
  "properties": {
    "schema": {"const": "aragorn/benchmark-phase0-acquisition-oracle/v1"},
    "root_suite_digest": {"$ref": "#/$defs/digest"},
    "expanded_suite_digest": {"$ref": "#/$defs/digest"},
    "split": {"const": "held_out"},
    "runs_per_case": {"const": 1},
    "candidate_system": {
      "$ref": "https://aragorn.dev/schema/benchmark-phase0-gate-report-v1.schema.json#/$defs/system"
    },
    "comparators": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "https://aragorn.dev/schema/benchmark-phase0-gate-report-v1.schema.json#/$defs/system"
      }
    },
    "expansion_profile": {
      "enum": [
        "phase0-exact-github-blob-expansion/v1",
        "phase0-exact-github-blob-expansion-terminal-depth-1/v1"
      ]
    },
    "expansion_assurance": {
      "enum": [
        "evaluation_only_github_api_membership_asserted_blob_identity_reverified",
        "evaluation_only_github_api_membership_asserted_blob_identity_reverified_depth_1_targets_terminal_not_reference_scanned"
      ]
    },
    "budgets": {"$ref": "#/$defs/budgets"},
    "cases": {
      "type": "array",
      "minItems": 448,
      "maxItems": 448,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "expansion_profile": {
            "const": "phase0-exact-github-blob-expansion-terminal-depth-1/v1"
          }
        },
        "required": ["expansion_profile"]
      },
      "then": {
        "required": ["expansion_assurance"],
        "properties": {
          "expansion_assurance": {
            "const": "evaluation_only_github_api_membership_asserted_blob_identity_reverified_depth_1_targets_terminal_not_reference_scanned"
          },
          "budgets": {
            "properties": {
              "expansion_depth": {"const": 1}
            },
            "required": ["expansion_depth"]
          }
        }
      },
      "else": {
        "properties": {
          "expansion_assurance": {
            "const": "evaluation_only_github_api_membership_asserted_blob_identity_reverified"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_requests",
        "api_bytes",
        "retained_bytes",
        "expanded_objects",
        "expansion_depth",
        "references"
      ],
      "properties": {
        "api_requests": {"type": "integer", "minimum": 1},
        "api_bytes": {"type": "integer", "minimum": 1},
        "retained_bytes": {"type": "integer", "minimum": 1},
        "expanded_objects": {"type": "integer", "minimum": 0},
        "expansion_depth": {"type": "integer", "minimum": 0},
        "references": {"type": "integer", "minimum": 1}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "class",
        "family",
        "lineage",
        "root_tree_digest",
        "expanded_tree_digest",
        "source",
        "expected_references"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "class": {"enum": ["benign", "adversarial"]},
        "family": {"$ref": "#/$defs/id"},
        "lineage": {"$ref": "#/$defs/id"},
        "root_tree_digest": {"$ref": "#/$defs/digest"},
        "expanded_tree_digest": {"$ref": "#/$defs/digest"},
        "source": {
          "$ref": "https://aragorn.dev/schema/github-expansion-v1.schema.json#/$defs/source"
        },
        "expected_references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "https://aragorn.dev/schema/benchmark-phase0-accounting-v1.schema.json#/$defs/expectedReference"
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"class": {"const": "benign"}}},
          "then": {"properties": {"family": {"const": "benign"}}},
          "else": {"properties": {"family": {"not": {"const": "benign"}}}}
        }
      ]
    }
  }
}
