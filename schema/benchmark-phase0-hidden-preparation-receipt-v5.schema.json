{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aragorn.dev/schema/benchmark-phase0-hidden-preparation-receipt-v5.schema.json",
  "title": "Aragorn Phase 0 hidden v5-compatible preparation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "recorded_on",
    "assurance",
    "source",
    "state",
    "worker",
    "preparation",
    "preparation_result_digest",
    "matrix",
    "worker_surface",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "aragorn/benchmark-phase0-hidden-preparation-receipt/v5"
    },
    "recorded_on": {
      "const": "2026-07-26"
    },
    "assurance": {
      "const": "operator_asserted_signed_preparation_not_independent_or_hardware_attested"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freeze_commit",
        "freeze_tree",
        "freeze_signature_status",
        "preparation_commit",
        "preparation_tree",
        "preparation_signature_status",
        "signer_principal",
        "signer_fingerprint",
        "hidden_suite_lock_digest",
        "freeze_receipt_digest"
      ],
      "properties": {
        "freeze_commit": {
          "enum": [
            "89ac883edd2c8617d310d90f468c502b8c864ff6",
            "1ad2b5fd6cba7fb140382596974bf0c72dd6babe"
          ]
        },
        "freeze_tree": {
          "enum": [
            "e03e83005e56079cd40d106a41367d978405810d",
            "955d2c431b7897254f1a3a6de9b78bc1a5ec38bd"
          ]
        },
        "freeze_signature_status": {"const": "verified"},
        "preparation_commit": {"$ref": "#/$defs/git_oid"},
        "preparation_tree": {"$ref": "#/$defs/git_oid"},
        "preparation_signature_status": {"const": "verified"},
        "signer_principal": {"const": "yousif.snazhat@gmail.com"},
        "signer_fingerprint": {
          "const": "SHA256:HJb87ljuOOkonZk+6GzgpASjhRMkRKBHKO3bzjuIDNk"
        },
        "hidden_suite_lock_digest": {
          "enum": [
            "sha256:d96bdbfdd1a8884cbc4dd0293ade0f04708f42627f7f336fb744661b8adbc0c6",
            "sha256:a862f355c21b3ce4e3d996b8cfd155856fa47a66a7e03f37a728e1aec3a99997"
          ]
        },
        "freeze_receipt_digest": {
          "enum": [
            "sha256:37a3d49ff1cb451fcc4db34fba55f83f07e3f1bdfea6467fffe60d3567646b4c",
            "sha256:d0bcb58ea1286e92a519081e31d34ef4062ee0cf6df9449a8f9a37f2fc6dbeb4"
          ]
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout",
        "binding_digest",
        "fresh_before_prepare",
        "outcomes_absent_after_prepare",
        "operator_uid_protected"
      ],
      "properties": {
        "layout": {"const": "phase0-hidden-run-state/v1"},
        "binding_digest": {
          "enum": [
            "sha256:0de77709907f1ee4aa332802e4da588c5e3a39e90908c7d5a7d43bf677d9a28f",
            "sha256:5e477520e56b346b22041862e1936fa0fb11fcd0a19b9d61e86226f5ec71d82f"
          ]
        },
        "fresh_before_prepare": {"const": true},
        "outcomes_absent_after_prepare": {"const": true},
        "operator_uid_protected": {"const": true}
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trust_domain",
        "worker_id",
        "key_id",
        "trust_store_digest",
        "key_provisioning",
        "trust_store_status"
      ],
      "properties": {
        "trust_domain": {
          "enum": [
            "phase0.hidden-local-v5.0.0",
            "phase0.hidden-local-v6.0.0"
          ]
        },
        "worker_id": {"const": "isolated-worker-01"},
        "key_id": {"$ref": "#/$defs/digest"},
        "trust_store_digest": {"$ref": "#/$defs/digest"},
        "key_provisioning": {
          "const": "operator_asserted_guest_generated_public_record_not_attested"
        },
        "trust_store_status": {
          "const": "verifier_owned_protected_file"
        }
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "suite_digest",
        "dispatch_digest",
        "candidate_policy_digest",
        "worker_identities_digest",
        "worklist_digest",
        "job_count"
      ],
      "properties": {
        "schema": {"const": "aragorn/benchmark-prepare-result/v2"},
        "suite_digest": {"$ref": "#/$defs/digest"},
        "dispatch_digest": {"$ref": "#/$defs/digest"},
        "candidate_policy_digest": {"$ref": "#/$defs/digest"},
        "worker_identities_digest": {"$ref": "#/$defs/digest"},
        "worklist_digest": {"$ref": "#/$defs/digest"},
        "job_count": {"const": 896}
      }
    },
    "preparation_result_digest": {"$ref": "#/$defs/digest"},
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "comparator_count",
        "runs_per_case",
        "job_count",
        "worklist_count",
        "issuance_count",
        "acceptance_count",
        "systems"
      ],
      "properties": {
        "case_count": {"const": 448},
        "comparator_count": {"const": 2},
        "runs_per_case": {"const": 1},
        "job_count": {"const": 896},
        "worklist_count": {"const": 896},
        "issuance_count": {"const": 896},
        "acceptance_count": {"const": 0},
        "systems": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "https://aragorn.dev/schema/benchmark-phase0-hidden-suite-lock-v1.schema.json#/$defs/system"
          }
        }
      }
    },
    "worker_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_count",
        "handoff_count",
        "semantic_validation",
        "forbidden_evaluator_metadata_absent"
      ],
      "properties": {
        "request_count": {"const": 896},
        "handoff_count": {"const": 896},
        "semantic_validation": {"const": "passed"},
        "forbidden_evaluator_metadata_absent": {"const": true}
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorship", "ordering", "custody", "worker_attestation"],
      "properties": {
        "authorship": {
          "const": "technical_codex_authorship_not_independent_human_identity"
        },
        "ordering": {
          "const": "signed_preparation_commit_verified_before_issuance"
        },
        "custody": {
          "const": "software_signatures_operator_uid_trusted_not_same_uid_or_hardware_attested"
        },
        "worker_attestation": {
          "const": "software_key_possession_not_vm_or_hardware_attestation"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
