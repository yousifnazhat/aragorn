{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aragorn.dev/schema/benchmark-phase2-gvisor-v4-evidence-v1.schema.json",
  "title": "Aragorn lock-bound attributed gVisor v4 benchmark evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "coverage_lock_digest",
    "suite_digest",
    "case_id",
    "tree_digest",
    "run_id",
    "system",
    "gvisor_receipt_digest",
    "verdict",
    "reason_codes"
  ],
  "properties": {
    "schema": {
      "const": "aragorn/benchmark-phase2-gvisor-v4-evidence/v1"
    },
    "authority": {
      "const": "LOCK_BOUND_ATTRIBUTED_GVISOR_V4_CATEGORY_DIFF_ONLY_NOT_PROCESS_ANCESTRY_SCRIPT_SAFETY_CAPTURE_COMPLETENESS_RUNTIME_ATTESTATION_ISOLATION_BACKEND_QUALIFICATION_ADMISSION_OR_PHASE2_EXIT_AUTHORITY"
    },
    "coverage_lock_digest": {"$ref": "#/$defs/digest"},
    "suite_digest": {"$ref": "#/$defs/digest"},
    "case_id": {"$ref": "#/$defs/id"},
    "tree_digest": {"$ref": "#/$defs/digest"},
    "run_id": {"type": "integer", "minimum": 1, "maximum": 5},
    "system": {"$ref": "#/$defs/system"},
    "gvisor_receipt_digest": {"$ref": "#/$defs/digest"},
    "verdict": {"enum": ["ALLOW", "REVIEW"]},
    "reason_codes": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"const": "UNDECLARED_OBSERVED_CAPABILITY"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"verdict": {"const": "ALLOW"}},
        "required": ["verdict"]
      },
      "then": {"properties": {"reason_codes": {"maxItems": 0}}},
      "else": {
        "properties": {
          "reason_codes": {"const": ["UNDECLARED_OBSERVED_CAPABILITY"]}
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "canonicalString": {
      "type": "string",
      "pattern": "^(?:\\S|\\S[^\\r\\n]*\\S)$"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "implementation_digest", "config_digest"],
      "properties": {
        "name": {"const": "aragorn"},
        "version": {
          "allOf": [
            {"$ref": "#/$defs/canonicalString"},
            {"maxLength": 256}
          ]
        },
        "implementation_digest": {"$ref": "#/$defs/digest"},
        "config_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
