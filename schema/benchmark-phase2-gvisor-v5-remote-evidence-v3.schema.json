{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aragorn.dev/schema/benchmark-phase2-gvisor-v5-remote-evidence-v3.schema.json",
  "title": "Aragorn lock-bound two-scenario attributed gVisor v5 plus remote-trace benchmark evidence v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "coverage_lock_digest",
    "suite_digest",
    "case_id",
    "tree_digest",
    "run_id",
    "scenario_id",
    "system",
    "gvisor_receipt_digest",
    "remote_trace_receipt_digest",
    "verdict",
    "reason_codes"
  ],
  "properties": {
    "schema": {
      "const": "aragorn/benchmark-phase2-gvisor-v5-remote-evidence/v3"
    },
    "authority": {
      "const": "LOCK_BOUND_TWO_SCENARIO_ATTRIBUTED_GVISOR_V5_CATEGORY_DIFF_AND_GVISOR_REMOTE_TRACE_V2_RAW_WIRE_CLOSURE_ONLY_NOT_PROCESS_ANCESTRY_SCRIPT_SAFETY_CAPTURE_COMPLETENESS_RUNTIME_ATTESTATION_ISOLATION_BACKEND_QUALIFICATION_ADMISSION_OR_PHASE2_EXIT_AUTHORITY"
    },
    "coverage_lock_digest": {"$ref": "#/$defs/digest"},
    "suite_digest": {"$ref": "#/$defs/digest"},
    "case_id": {"$ref": "#/$defs/id"},
    "tree_digest": {"$ref": "#/$defs/digest"},
    "run_id": {"type": "integer", "minimum": 1, "maximum": 5},
    "scenario_id": {"enum": ["primary", "alternate"]},
    "system": {"$ref": "#/$defs/system"},
    "gvisor_receipt_digest": {"$ref": "#/$defs/digest"},
    "remote_trace_receipt_digest": {"$ref": "#/$defs/digest"},
    "verdict": {"enum": ["ALLOW", "REVIEW"]},
    "reason_codes": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"const": "UNDECLARED_OBSERVED_CAPABILITY"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"verdict": {"const": "ALLOW"}},
        "required": ["verdict"]
      },
      "then": {"properties": {"reason_codes": {"maxItems": 0}}},
      "else": {
        "properties": {
          "reason_codes": {"const": ["UNDECLARED_OBSERVED_CAPABILITY"]}
        }
      }
    },
    {
      "if": {"properties": {"run_id": {"enum": [1, 3, 5]}}},
      "then": {"properties": {"scenario_id": {"const": "primary"}}},
      "else": {"properties": {"scenario_id": {"const": "alternate"}}}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "canonicalString": {
      "type": "string",
      "pattern": "^(?:\\S|\\S[^\\r\\n]*\\S)$"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "implementation_digest", "config_digest"],
      "properties": {
        "name": {"const": "aragorn"},
        "version": {
          "allOf": [
            {"$ref": "#/$defs/canonicalString"},
            {"maxLength": 256}
          ]
        },
        "implementation_digest": {"$ref": "#/$defs/digest"},
        "config_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
