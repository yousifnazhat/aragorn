{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aragorn.dev/schema/benchmark-phase2-metrics-checkpoint-v1.schema.json",
  "title": "Aragorn Phase 2 declared-unfrozen five-run metrics checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assurance",
    "phase2_exit_eligible",
    "missing_phase2_exit_requirements",
    "suite_id",
    "purpose",
    "suite_digest",
    "outcomes_digest",
    "benchmark_report_digest",
    "evaluation_split",
    "runs_per_case",
    "candidate",
    "thresholds",
    "observed",
    "decision"
  ],
  "properties": {
    "schema": {"const": "aragorn/benchmark-phase2-metrics-checkpoint/v1"},
    "assurance": {"const": "declared_unfrozen_held_out_five_run_metrics_only"},
    "phase2_exit_eligible": {"const": false},
    "missing_phase2_exit_requirements": {
      "const": [
        "ATTRIBUTED_DETONATION_EVIDENCE_REQUIRED",
        "CAPTURE_COMPLETENESS_REQUIRED",
        "FROZEN_COVERAGE_AND_CANDIDATE_LOCK_REQUIRED",
        "QUALIFIED_ISOLATED_BACKEND_REQUIRED",
        "VARIED_SCENARIO_MATRIX_REQUIRED"
      ]
    },
    "suite_id": {"$ref": "#/$defs/id"},
    "purpose": {"const": "evidence_smoke"},
    "suite_digest": {"$ref": "#/$defs/digest"},
    "outcomes_digest": {"$ref": "#/$defs/digest"},
    "benchmark_report_digest": {"$ref": "#/$defs/digest"},
    "evaluation_split": {"const": "held_out"},
    "runs_per_case": {"const": 5},
    "candidate": {"$ref": "#/$defs/system"},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_adversarial_flag",
        "minimum_attack_family_flag",
        "maximum_benign_intervention",
        "minimum_verdict_agreement"
      ],
      "properties": {
        "minimum_adversarial_flag": {
          "const": {"numerator": 9, "denominator": 10}
        },
        "minimum_attack_family_flag": {
          "const": {"numerator": 4, "denominator": 5}
        },
        "maximum_benign_intervention": {
          "const": {"numerator": 1, "denominator": 20}
        },
        "minimum_verdict_agreement": {
          "const": {"numerator": 19, "denominator": 20}
        }
      }
    },
    "observed": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adversarial_flag",
            "benign_intervention",
            "verdict_agreement",
            "error_outcomes",
            "families"
          ],
          "properties": {
            "adversarial_flag": {"$ref": "#/$defs/fraction"},
            "benign_intervention": {"$ref": "#/$defs/fraction"},
            "verdict_agreement": {
              "oneOf": [
                {"type": "null"},
                {"$ref": "#/$defs/fraction"}
              ]
            },
            "error_outcomes": {"type": "integer", "minimum": 0},
            "families": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/family"}
            }
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluable", "metrics_passed", "reason_codes"],
      "properties": {
        "evaluable": {"type": "boolean"},
        "metrics_passed": {"type": "boolean"},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ADVERSARIAL_FLAG_RATE_BELOW_90_PERCENT",
              "ATTACK_FAMILY_FLAG_RATE_BELOW_80_PERCENT",
              "BENIGN_INTERVENTION_RATE_ABOVE_5_PERCENT",
              "ERROR_OUTCOMES_PRESENT",
              "NO_HELD_OUT_SPLIT",
              "VERDICT_AGREEMENT_BELOW_95_PERCENT",
              "VERDICT_AGREEMENT_NOT_EVALUABLE"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"observed": {"type": "null"}},
        "required": ["observed"]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "evaluable": {"const": false},
              "metrics_passed": {"const": false}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {"metrics_passed": {"const": true}},
            "required": ["metrics_passed"]
          }
        }
      },
      "then": {
        "properties": {
          "observed": {"type": "object"},
          "decision": {
            "properties": {
              "evaluable": {"const": true},
              "reason_codes": {"maxItems": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {"metrics_passed": {"const": false}},
            "required": ["metrics_passed"]
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {"reason_codes": {"minItems": 1}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observed": {
            "type": "object",
            "properties": {"error_outcomes": {"minimum": 1}},
            "required": ["error_outcomes"]
          }
        }
      },
      "then": {
        "properties": {
          "observed": {
            "properties": {"verdict_agreement": {"type": "null"}}
          },
          "decision": {
            "properties": {
              "evaluable": {"const": false},
              "metrics_passed": {"const": false}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "canonicalString": {
      "type": "string",
      "pattern": "^(?:\\S|\\S[^\\r\\n]*\\S)$"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "implementation_digest", "config_digest"],
      "properties": {
        "name": {"const": "aragorn"},
        "version": {
          "allOf": [
            {"$ref": "#/$defs/canonicalString"},
            {"maxLength": 256}
          ]
        },
        "implementation_digest": {"$ref": "#/$defs/digest"},
        "config_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "fraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "adversarial_flag"],
      "properties": {
        "family": {"$ref": "#/$defs/id"},
        "adversarial_flag": {"$ref": "#/$defs/fraction"}
      }
    }
  }
}
