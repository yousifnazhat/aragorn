{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn host-independent benchmark portable policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "system",
    "baseline",
    "image",
    "entrypoint",
    "arguments",
    "environment",
    "runtime_profile",
    "limits",
    "normalization"
  ],
  "properties": {
    "schema": {"const": "aragorn/benchmark-portable-policy/v1"},
    "system": {"$ref": "#/$defs/system"},
    "baseline": {"$ref": "#/$defs/baseline"},
    "image": {"$ref": "#/$defs/image"},
    "entrypoint": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/portable_text"}
    },
    "arguments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "contains": {"const": "/workspace"},
      "minContains": 1,
      "maxContains": 1,
      "items": {"$ref": "#/$defs/portable_text"}
    },
    "environment": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "allOf": [
          {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          {
            "not": {
              "enum": [
                "attestation",
                "ATTESTATION",
                "attested",
                "ATTESTED",
                "case_id",
                "CASE_ID",
                "class",
                "CLASS",
                "docker_config",
                "DOCKER_CONFIG",
                "docker_context",
                "DOCKER_CONTEXT",
                "docker_host",
                "DOCKER_HOST",
                "expected_verdict",
                "EXPECTED_VERDICT",
                "family",
                "FAMILY",
                "host_path",
                "HOST_PATH",
                "label",
                "LABEL",
                "labels",
                "LABELS",
                "lineage",
                "LINEAGE",
                "purpose",
                "PURPOSE",
                "run_id",
                "RUN_ID",
                "runner_identity",
                "RUNNER_IDENTITY",
                "runtime_identity",
                "RUNTIME_IDENTITY",
                "signature",
                "SIGNATURE",
                "source",
                "SOURCE",
                "split",
                "SPLIT",
                "suite_digest",
                "SUITE_DIGEST",
                "worker_assurance",
                "WORKER_ASSURANCE",
                "workspace_source",
                "WORKSPACE_SOURCE"
              ]
            }
          }
        ]
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 16384,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
      }
    },
    "runtime_profile": {"$ref": "#/$defs/runtime_profile"},
    "limits": {"$ref": "#/$defs/limits"},
    "normalization": {
      "enum": [
        "cisco-ai-skill-scanner-2.0.12/v1",
        "nvidia-skillspector-2.4.3/v1"
      ]
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "system": {
              "properties": {
                "name": {"const": "cisco-skill-scanner"}
              },
              "required": ["name"]
            },
            "image": {
              "properties": {
                "platform_manifest_digest": {
                  "const": "sha256:7fadcfbe836eef9490feba0fadd2ada564c11eb541077e3efee5f61edbd2e65c"
                }
              },
              "required": ["platform_manifest_digest"]
            },
            "normalization": {
              "const": "cisco-ai-skill-scanner-2.0.12/v1"
            }
          }
        },
        {
          "properties": {
            "system": {
              "properties": {
                "name": {"const": "skillspector"}
              },
              "required": ["name"]
            },
            "image": {
              "properties": {
                "platform_manifest_digest": {
                  "const": "sha256:e731be01105243f94437a4b9bd449bd46bbcb5cb306f44b4845121d109a4a95e"
                }
              },
              "required": ["platform_manifest_digest"]
            },
            "normalization": {
              "const": "nvidia-skillspector-2.4.3/v1"
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "portable_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "allOf": [
        {
          "not": {
            "pattern": "(?:[Uu][Nn][Ii][Xx]://|[Nn][Pp][Ii][Pp][Ee]://|[Dd][Oo][Cc][Kk][Ee][Rr]://|/[Vv][Aa][Rr]/[Rr][Uu][Nn]/[Dd][Oo][Cc][Kk][Ee][Rr]\\.[Ss][Oo][Cc][Kk]|/[Rr][Uu][Nn]/[Dd][Oo][Cc][Kk][Ee][Rr]\\.[Ss][Oo][Cc][Kk])"
          }
        },
        {
          "not": {
            "pattern": "(?:^|[=,:])(?:/[Uu][Ss][Ee][Rr][Ss]/|[A-Za-z]:[\\\\/]|\\\\\\\\)"
          }
        }
      ]
    },
    "system": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "implementation_digest"],
          "properties": {
            "name": {"const": "cisco-skill-scanner"},
            "version": {"const": "2.0.12"},
            "implementation_digest": {
              "const": "sha256:7fadcfbe836eef9490feba0fadd2ada564c11eb541077e3efee5f61edbd2e65c"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "implementation_digest"],
          "properties": {
            "name": {"const": "skillspector"},
            "version": {"const": "2.4.3+git.a54947c"},
            "implementation_digest": {
              "const": "sha256:e731be01105243f94437a4b9bd449bd46bbcb5cb306f44b4845121d109a4a95e"
            }
          }
        }
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lock_digest", "entry_digest"],
      "properties": {
        "lock_digest": {"$ref": "#/$defs/digest"},
        "entry_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_digest",
        "platform_manifest_digest",
        "config_digest",
        "build_provenance_manifest_digest",
        "os",
        "architecture",
        "size_bytes"
      ],
      "properties": {
        "index_digest": {"$ref": "#/$defs/digest"},
        "platform_manifest_digest": {"$ref": "#/$defs/digest"},
        "config_digest": {"$ref": "#/$defs/digest"},
        "build_provenance_manifest_digest": {"$ref": "#/$defs/digest"},
        "os": {"const": "linux"},
        "architecture": {"enum": ["arm64", "amd64"]},
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17592186044416
        }
      }
    },
    "runtime_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "pull",
        "network",
        "read_only_rootfs",
        "cap_drop",
        "no_new_privileges",
        "user",
        "workdir",
        "pids_limit",
        "memory_bytes",
        "memory_swap_bytes",
        "cpus",
        "nofile_soft",
        "nofile_hard",
        "tmpfs",
        "workspace"
      ],
      "properties": {
        "engine": {"const": "docker"},
        "pull": {"const": "never"},
        "network": {"const": "none"},
        "read_only_rootfs": {"const": true},
        "cap_drop": {"const": ["ALL"]},
        "no_new_privileges": {"const": true},
        "user": {"const": "65532:65532"},
        "workdir": {"const": "/opt/aragorn-control"},
        "pids_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1125899906842624
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1125899906842624
        },
        "memory_swap_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1125899906842624
        },
        "cpus": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1024
        },
        "nofile_soft": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1125899906842624
        },
        "nofile_hard": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1125899906842624
        },
        "tmpfs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["destination", "size_bytes", "options"],
          "properties": {
            "destination": {"const": "/tmp"},
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1125899906842624
            },
            "options": {
              "const": ["rw", "noexec", "nosuid", "nodev", "mode=1777"]
            }
          }
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["destination", "read_only"],
          "properties": {
            "destination": {"const": "/workspace"},
            "read_only": {"const": true}
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "output_bytes"],
      "properties": {
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    }
  }
}
