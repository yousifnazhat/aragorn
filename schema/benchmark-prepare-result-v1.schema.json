{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn label-free benchmark preparation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "suite_digest",
    "dispatch_digest",
    "worker_identities_digest",
    "worklist_digest",
    "job_count"
  ],
  "properties": {
    "schema": {"const": "aragorn/benchmark-prepare-result/v1"},
    "suite_digest": {"$ref": "#/$defs/digest"},
    "dispatch_digest": {"$ref": "#/$defs/digest"},
    "worker_identities_digest": {"$ref": "#/$defs/digest"},
    "worklist_digest": {"$ref": "#/$defs/digest"},
    "job_count": {"type": "integer", "minimum": 1, "maximum": 200000}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
