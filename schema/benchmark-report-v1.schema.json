{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn deterministic benchmark report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "suite_id",
    "purpose",
    "runs_per_case",
    "suite_digest",
    "outcomes_digest",
    "systems"
  ],
  "properties": {
    "schema": {"const": "aragorn/benchmark-report/v1"},
    "suite_id": {"$ref": "#/$defs/id"},
    "purpose": {"enum": ["contract_smoke", "evidence_smoke"]},
    "runs_per_case": {"type": "integer", "minimum": 1, "maximum": 10},
    "suite_digest": {"$ref": "#/$defs/digest"},
    "outcomes_digest": {"$ref": "#/$defs/digest"},
    "systems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system", "overall", "repeatability", "splits"],
        "properties": {
          "system": {"$ref": "#/$defs/system"},
          "overall": {"$ref": "#/$defs/summary"},
          "repeatability": {"$ref": "#/$defs/repeatability"},
          "splits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["split", "summary", "repeatability", "families"],
              "properties": {
                "split": {"enum": ["development", "held_out", "hidden"]},
                "summary": {"$ref": "#/$defs/summary"},
                "repeatability": {"$ref": "#/$defs/repeatability"},
                "families": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/family"}
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "canonicalString": {
      "type": "string",
      "pattern": "^(?:\\S|\\S[^\\r\\n]*\\S)$"
    },
    "nullableRate": {
      "anyOf": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "null"}
      ]
    },
    "nullableCount": {
      "anyOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "implementation_digest", "config_digest"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "version": {
          "allOf": [
            {"$ref": "#/$defs/canonicalString"},
            {"maxLength": 256}
          ]
        },
        "implementation_digest": {"$ref": "#/$defs/digest"},
        "config_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "verdicts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ALLOW", "REVIEW", "DENY", "ERROR"],
      "properties": {
        "ALLOW": {"type": "integer", "minimum": 0},
        "REVIEW": {"type": "integer", "minimum": 0},
        "DENY": {"type": "integer", "minimum": 0},
        "ERROR": {"type": "integer", "minimum": 0}
      }
    },
    "classVerdicts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benign", "adversarial"],
      "properties": {
        "benign": {"$ref": "#/$defs/verdicts"},
        "adversarial": {"$ref": "#/$defs/verdicts"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "runs_per_case",
        "evaluations",
        "benign_cases",
        "adversarial_cases",
        "verdicts",
        "class_verdicts",
        "adversarial_allowed",
        "adversarial_flagged",
        "benign_reviewed",
        "benign_denied",
        "benign_intervened",
        "adversarial_flag_rate",
        "adversarial_allow_rate",
        "benign_review_rate",
        "benign_deny_rate",
        "benign_intervention_rate",
        "benign_error_rate",
        "adversarial_error_rate",
        "error_rate",
        "flag_precision"
      ],
      "properties": {
        "cases": {"type": "integer", "minimum": 2},
        "runs_per_case": {"type": "integer", "minimum": 1, "maximum": 10},
        "evaluations": {"type": "integer", "minimum": 2},
        "benign_cases": {"type": "integer", "minimum": 1},
        "adversarial_cases": {"type": "integer", "minimum": 1},
        "verdicts": {"$ref": "#/$defs/verdicts"},
        "class_verdicts": {"$ref": "#/$defs/classVerdicts"},
        "adversarial_allowed": {"type": "integer", "minimum": 0},
        "adversarial_flagged": {"type": "integer", "minimum": 0},
        "benign_reviewed": {"type": "integer", "minimum": 0},
        "benign_denied": {"type": "integer", "minimum": 0},
        "benign_intervened": {"type": "integer", "minimum": 0},
        "adversarial_flag_rate": {"$ref": "#/$defs/nullableRate"},
        "adversarial_allow_rate": {"$ref": "#/$defs/nullableRate"},
        "benign_review_rate": {"$ref": "#/$defs/nullableRate"},
        "benign_deny_rate": {"$ref": "#/$defs/nullableRate"},
        "benign_intervention_rate": {"$ref": "#/$defs/nullableRate"},
        "benign_error_rate": {"$ref": "#/$defs/nullableRate"},
        "adversarial_error_rate": {"$ref": "#/$defs/nullableRate"},
        "error_rate": {"$ref": "#/$defs/nullableRate"},
        "flag_precision": {"$ref": "#/$defs/nullableRate"}
      }
    },
    "repeatability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runs_per_case",
        "evaluable",
        "cases",
        "evaluable_cases",
        "error_cases",
        "unanimous_cases",
        "unanimous_rate",
        "verdict_agreement"
      ],
      "properties": {
        "runs_per_case": {"type": "integer", "minimum": 1, "maximum": 10},
        "evaluable": {"type": "boolean"},
        "cases": {"type": "integer", "minimum": 1},
        "evaluable_cases": {"type": "integer", "minimum": 0},
        "error_cases": {"type": "integer", "minimum": 0},
        "unanimous_cases": {"$ref": "#/$defs/nullableCount"},
        "unanimous_rate": {"$ref": "#/$defs/nullableRate"},
        "verdict_agreement": {"$ref": "#/$defs/nullableRate"}
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "cases",
        "runs_per_case",
        "evaluations",
        "verdicts",
        "allowed",
        "reviewed",
        "denied",
        "errors",
        "flagged",
        "flag_rate",
        "error_rate",
        "repeatability"
      ],
      "properties": {
        "family": {"$ref": "#/$defs/id"},
        "cases": {"type": "integer", "minimum": 1},
        "runs_per_case": {"type": "integer", "minimum": 1, "maximum": 10},
        "evaluations": {"type": "integer", "minimum": 1},
        "verdicts": {"$ref": "#/$defs/verdicts"},
        "allowed": {"type": "integer", "minimum": 0},
        "reviewed": {"type": "integer", "minimum": 0},
        "denied": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "flagged": {"type": "integer", "minimum": 0},
        "flag_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "error_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "repeatability": {"$ref": "#/$defs/repeatability"}
      }
    }
  }
}
