{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn label-free benchmark subject manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tree_digest", "files"],
  "properties": {
    "schema": {"const": "aragorn/benchmark-subject-manifest/v1"},
    "tree_digest": {"$ref": "#/$defs/digest"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/file"}
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*[\\u0000-\\u001f\\u007f-\\u009f])(?!(?:\\.|\\.\\.)(?:/|$))(?!.*\/(?:\\.|\\.\\.)(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "digest", "executable"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "digest": {"$ref": "#/$defs/digest"},
        "executable": {"const": false}
      }
    }
  }
}
