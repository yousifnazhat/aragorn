{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn effective benchmark system configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "version",
    "executable_digest",
    "operator_argv0",
    "argv_tail",
    "limits",
    "normalization"
  ],
  "properties": {
    "schema": {"const": "aragorn/benchmark-system-config/v1"},
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:\\S|\\S[^\\r\\n]*\\S)$",
      "maxLength": 256
    },
    "executable_digest": {"$ref": "#/$defs/digest"},
    "operator_argv0": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "argv_tail": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "output_bytes"],
      "properties": {
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    },
    "normalization": {"const": "aragorn-observation-severity/v1"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
