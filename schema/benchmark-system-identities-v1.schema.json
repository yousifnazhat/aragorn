{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn benchmark system identities v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "systems"],
  "properties": {
    "schema": {"const": "aragorn/benchmark-system-identities/v1"},
    "systems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/system"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "implementation_digest", "config_digest"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "version": {
          "type": "string",
          "pattern": "^(?:\\S|\\S[^\\r\\n]*\\S)$",
          "maxLength": 256
        },
        "implementation_digest": {"$ref": "#/$defs/digest"},
        "config_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
