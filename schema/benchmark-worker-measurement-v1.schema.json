{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn signed protocol-v2 worker measurement statement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope",
    "algorithm",
    "trust_domain",
    "worker_id",
    "key_id",
    "job_id",
    "verifier_challenge",
    "request_digest",
    "result_digest",
    "handoff_manifest_digest"
  ],
  "properties": {
    "schema": {"const": "aragorn/benchmark-worker-measurement/v1"},
    "scope": {"const": "aragorn/benchmark-worker-output/v2"},
    "algorithm": {"const": "Ed25519"},
    "trust_domain": {"$ref": "#/$defs/identifier"},
    "worker_id": {"$ref": "#/$defs/identifier"},
    "key_id": {"$ref": "#/$defs/digest"},
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "verifier_challenge": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_digest": {"$ref": "#/$defs/digest"},
    "result_digest": {"$ref": "#/$defs/digest"},
    "handoff_manifest_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    }
  }
}
