{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn exact label-free worker output closure v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "job_id",
    "request_digest",
    "result_digest",
    "blobs",
    "total_bytes"
  ],
  "properties": {
    "schema": {"const": "aragorn/benchmark-worker-output-closure/v1"},
    "job_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "result_digest": {"$ref": "#/$defs/digest"},
    "blobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["digest", "size"],
        "properties": {
          "digest": {"$ref": "#/$defs/digest"},
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 134217728
          }
        }
      }
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 536870912
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
