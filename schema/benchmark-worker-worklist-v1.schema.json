{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn label-free worker scheduling list v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "jobs"],
  "properties": {
    "schema": {"const": "aragorn/benchmark-worker-worklist/v1"},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "request_digest"],
        "properties": {
          "job_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
          "request_digest": {"$ref": "#/$defs/digest"}
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
