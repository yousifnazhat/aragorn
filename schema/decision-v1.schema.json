{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aragorn.dev/schema/decision-v1.schema.json",
  "title": "Aragorn decision receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "verdict",
    "manifest_digest",
    "tree_digest",
    "artifact_digests",
    "policy",
    "analyzers",
    "reason_codes"
  ],
  "properties": {
    "schema": {"const": "aragorn/decision/v1"},
    "verdict": {"enum": ["ALLOW", "REVIEW", "DENY", "ERROR"]},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "tree_digest": {"$ref": "#/$defs/digest"},
    "artifact_digests": {
      "type": "array",
      "items": {"$ref": "#/$defs/digest"}
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "analyzers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "config_digest",
          "executable_digest",
          "status",
          "observation_digests",
          "stdout_digest",
          "stderr_digest"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "config_digest": {"$ref": "#/$defs/digest"},
          "executable_digest": {"$ref": "#/$defs/digest"},
          "status": {"enum": ["ok", "error"]},
          "observation_digests": {
            "type": "array",
            "items": {"$ref": "#/$defs/digest"}
          },
          "stdout_digest": {"$ref": "#/$defs/digest"},
          "stderr_digest": {"$ref": "#/$defs/digest"},
          "error_code": {"type": "string"},
          "returncode": {"type": "integer"}
        }
      }
    },
    "reason_codes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
