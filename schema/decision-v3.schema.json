{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aragorn.dev/schema/decision-v3.schema.json",
  "title": "Aragorn graph-bound decision receipt v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "verdict",
    "manifest_digest",
    "artifact_graph_digest",
    "tree_digest",
    "artifact_digests",
    "policy",
    "analyzers",
    "reason_codes"
  ],
  "properties": {
    "schema": {"const": "aragorn/decision/v3"},
    "authority": {"const": "EVIDENCE_SUMMARY_ONLY_NOT_INSTALLER_AUTHORITY"},
    "verdict": {"enum": ["ALLOW", "REVIEW", "DENY", "ERROR"]},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "artifact_graph_digest": {"$ref": "#/$defs/digest"},
    "tree_digest": {"$ref": "#/$defs/digest"},
    "artifact_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/digest"}
    },
    "policy": {
      "$ref": "https://aragorn.dev/schema/decision-v2.schema.json#/properties/policy"
    },
    "analyzers": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "https://aragorn.dev/schema/decision-v2.schema.json#/properties/analyzers/items"
      }
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
