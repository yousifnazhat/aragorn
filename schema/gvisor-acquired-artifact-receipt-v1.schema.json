{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aragorn.dev/schema/gvisor-acquired-artifact-receipt-v1.schema.json",
  "title": "Aragorn one-fixture acquired-artifact gVisor receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "lock_digest",
    "runtime_lock_digest",
    "implementation_digest",
    "run_id",
    "captured_at",
    "subject_digest",
    "input_manifest_digest",
    "input_tree_digest",
    "run_request_digest",
    "normalizer_implementation_digest",
    "capability_diff_receipt_digest",
    "quarantine_receipt_digest",
    "gateway_profile_digest",
    "source_closure_digest",
    "entrypoint",
    "evidence",
    "status"
  ],
  "properties": {
    "schema": {"const": "aragorn/gvisor-acquired-artifact-receipt/v1"},
    "authority": {
      "const": "ONE_INERT_ACQUIRED_ARTIFACT_SAME_RUN_EVIDENCE_ONLY_NOT_CAPTURE_COMPLETENESS_RUNTIME_ATTESTATION_ISOLATION_BACKEND_QUALIFICATION_ADMISSION_OR_PHASE2_EXIT_AUTHORITY"
    },
    "lock_digest": {"$ref": "#/$defs/digest"},
    "runtime_lock_digest": {"$ref": "#/$defs/digest"},
    "implementation_digest": {"$ref": "#/$defs/digest"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "captured_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "subject_digest": {"$ref": "#/$defs/digest"},
    "input_manifest_digest": {"$ref": "#/$defs/digest"},
    "input_tree_digest": {"$ref": "#/$defs/digest"},
    "run_request_digest": {"$ref": "#/$defs/digest"},
    "normalizer_implementation_digest": {"$ref": "#/$defs/digest"},
    "capability_diff_receipt_digest": {"$ref": "#/$defs/digest"},
    "quarantine_receipt_digest": {"$ref": "#/$defs/digest"},
    "gateway_profile_digest": {"$ref": "#/$defs/digest"},
    "source_closure_digest": {"$ref": "#/$defs/digest"},
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "size", "executable", "container_path"],
      "properties": {
        "path": {"const": "run.sh"},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1, "maximum": 65536},
        "executable": {"const": true},
        "container_path": {"const": "/aragorn-input/run.sh"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_version",
        "installed_binaries",
        "daemon_config",
        "runtime_registration",
        "docker_executable",
        "helper_implementations",
        "runner_pre",
        "runner_post",
        "image_inspect",
        "container_pre_inspect",
        "container_live_inspect",
        "container_processes",
        "container_stdout",
        "container_stderr",
        "container_post_inspect",
        "backend_log_manifest",
        "container_cleanup",
        "artifact_source"
      ],
      "properties": {
        "runtime_version": {"$ref": "#/$defs/digest"},
        "installed_binaries": {"$ref": "#/$defs/digest"},
        "daemon_config": {"$ref": "#/$defs/digest"},
        "runtime_registration": {"$ref": "#/$defs/digest"},
        "docker_executable": {"$ref": "#/$defs/digest"},
        "helper_implementations": {"$ref": "#/$defs/digest"},
        "runner_pre": {"$ref": "#/$defs/digest"},
        "runner_post": {"$ref": "#/$defs/digest"},
        "image_inspect": {"$ref": "#/$defs/digest"},
        "container_pre_inspect": {"$ref": "#/$defs/digest"},
        "container_live_inspect": {"$ref": "#/$defs/digest"},
        "container_processes": {"$ref": "#/$defs/digest"},
        "container_stdout": {"$ref": "#/$defs/digest"},
        "container_stderr": {"$ref": "#/$defs/digest"},
        "container_post_inspect": {"$ref": "#/$defs/digest"},
        "backend_log_manifest": {"$ref": "#/$defs/digest"},
        "container_cleanup": {"$ref": "#/$defs/digest"},
        "artifact_source": {"$ref": "#/$defs/digest"}
      }
    },
    "status": {"const": "RECORDED"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
