{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn inventory result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_digest",
    "tree_digest",
    "file_count",
    "closure"
  ],
  "properties": {
    "schema": {"const": "aragorn/inventory-result/v1"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "tree_digest": {"$ref": "#/$defs/digest"},
    "file_count": {"type": "integer", "minimum": 0},
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "status"],
      "properties": {
        "scope": {"enum": ["source_tree", "artifact_graph"]},
        "status": {"enum": ["complete", "incomplete"]},
        "unresolved": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
