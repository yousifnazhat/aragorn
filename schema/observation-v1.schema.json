{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn analyzer observation v1",
  "type": "object",
  "required": ["schema", "subject_digest", "reason_code", "severity"],
  "properties": {
    "schema": {"const": "aragorn/observation/v1"},
    "subject_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
    },
    "severity": {"enum": ["info", "low", "medium", "high", "critical"]}
  }
}
