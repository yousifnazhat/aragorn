{
  "$id": "https://aragorn.dev/schema/phase1-acquisition-lock-milestone-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn Phase 1 acquisition-lock milestone v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_evidence_digest",
    "workload_digest",
    "claims",
    "decision"
  ],
  "properties": {
    "schema": {"const": "aragorn/phase1-acquisition-lock-milestone/v2"},
    "source_evidence_digest": {"$ref": "#/$defs/digest"},
    "workload_digest": {
      "const": "sha256:32a03e4b6fa8327055fd8b0d404091dc12b067897160e7b6a5abfa4ae22f64f2"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installed_digest_integrity",
        "static_artifact_capture",
        "unresolved_required_non_allow"
      ],
      "properties": {
        "installed_digest_integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trees",
            "files",
            "mismatches",
            "changed_paths",
            "status"
          ],
          "properties": {
            "trees": {"type": "integer", "minimum": 0},
            "files": {"type": "integer", "minimum": 0},
            "mismatches": {"type": "integer", "minimum": 0},
            "changed_paths": {"type": "integer", "minimum": 0},
            "status": {"$ref": "#/$defs/status"}
          },
          "allOf": [
            {
              "if": {
                "required": ["status"],
                "properties": {"status": {"const": "PASS"}}
              },
              "then": {
                "properties": {
                  "trees": {"const": 2},
                  "files": {"const": 4},
                  "mismatches": {"const": 0},
                  "changed_paths": {"minimum": 1}
                }
              }
            }
          ]
        },
        "static_artifact_capture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "captured",
            "total",
            "percent",
            "minimum_percent",
            "status"
          ],
          "properties": {
            "captured": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 0},
            "percent": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 100
            },
            "minimum_percent": {"const": 95},
            "status": {"$ref": "#/$defs/status"}
          },
          "allOf": [
            {
              "if": {
                "required": ["status"],
                "properties": {"status": {"const": "PASS"}}
              },
              "then": {
                "properties": {
                  "captured": {"const": 13},
                  "total": {"const": 13},
                  "percent": {"type": "number", "minimum": 95}
                }
              }
            }
          ]
        },
        "unresolved_required_non_allow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "qualifying",
            "total",
            "allowed_outcomes",
            "observed_outcome",
            "status"
          ],
          "properties": {
            "qualifying": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 0},
            "allowed_outcomes": {"const": ["ERROR", "REVIEW"]},
            "observed_outcome": {
              "enum": ["ALLOW", "REVIEW", "DENY", "ERROR", null]
            },
            "status": {"$ref": "#/$defs/status"}
          },
          "allOf": [
            {
              "if": {
                "required": ["status"],
                "properties": {"status": {"const": "PASS"}}
              },
              "then": {
                "properties": {
                  "qualifying": {"const": 18},
                  "total": {"const": 18},
                  "observed_outcome": {"enum": ["ERROR", "REVIEW"]}
                }
              }
            }
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "acquisition_lock_exit_eligible",
        "reason_codes"
      ],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "acquisition_lock_exit_eligible": {"type": "boolean"},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reason"}
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {"status": {"const": "PASS"}}
          },
          "then": {
            "properties": {
              "acquisition_lock_exit_eligible": {"const": true},
              "reason_codes": {"maxItems": 0}
            }
          },
          "else": {
            "properties": {
              "acquisition_lock_exit_eligible": {"const": false},
              "reason_codes": {"minItems": 1}
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reason": {
      "enum": [
        "INSTALLED_DIGEST_INTEGRITY_NOT_PASS",
        "STATIC_ARTIFACT_CAPTURE_NOT_PASS",
        "UNRESOLVED_REQUIRED_NON_ALLOW_NOT_PASS"
      ]
    },
    "status": {
      "enum": ["PASS", "FAIL", "NOT_TESTED"]
    }
  }
}
