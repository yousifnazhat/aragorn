{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aragorn.dev/schema/phase2-matrix-catalog-v3.schema.json",
  "title": "Aragorn operator-authored inert Phase 2 remote-trace scenario matrix catalog v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assurance",
    "source",
    "candidate",
    "scenario_matrix",
    "cases"
  ],
  "properties": {
    "schema": {"const": "aragorn/phase2-matrix-catalog/v3"},
    "assurance": {
      "const": "operator_authored_inert_plumbing_not_independent_efficacy"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "repository", "commit", "case_root"],
      "properties": {
        "owner": {"const": "yousifnazhat"},
        "repository": {"const": "agent-skill-inert-fixture"},
        "commit": {
          "const": "fdf9111395179343a742d9dd6649e6d5f9da737b"
        },
        "case_root": {"const": "cases"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "config"],
      "properties": {
        "name": {"const": "aragorn"},
        "version": {
          "type": "string",
          "pattern": "^(?:\\S|\\S[^\\r\\n]*\\S)$",
          "maxLength": 256
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evaluation_split",
            "runs_per_case",
            "verdict_profile",
            "gvisor_receipt_schema",
            "normalization_profile",
            "execution_profile",
            "entrypoint_path",
            "remote_trace_receipt_schema",
            "remote_trace_profile"
          ],
          "properties": {
            "evaluation_split": {"const": "held_out"},
            "runs_per_case": {"const": 5},
            "verdict_profile": {"const": "undeclared-observed-review/v1"},
            "gvisor_receipt_schema": {
              "const": "aragorn/gvisor-acquired-artifact-receipt/v5"
            },
            "normalization_profile": {
              "const": "successful-openat-execve-attributed/v1"
            },
            "execution_profile": {"const": "bounded-single-script/v2"},
            "entrypoint_path": {"const": "run.sh"},
            "remote_trace_receipt_schema": {
              "const": "aragorn/gvisor-remote-trace-capture-receipt/v2"
            },
            "remote_trace_profile": {
              "const": "gvisor-remote-default-pod-init-seqpacket/v1"
            }
          }
        }
      }
    },
    "scenario_matrix": {"$ref": "#/$defs/scenarioMatrix"},
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "capability": {
      "enum": [
        "file-read",
        "file-write",
        "memory-write",
        "network-connect",
        "process-exec",
        "tool-call"
      ]
    },
    "scenarioMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "environment_variable", "run_schedule"],
      "properties": {
        "profile": {"const": "two-scenario-path-surface/v1"},
        "environment_variable": {"const": "ARAGORN_SCENARIO"},
        "run_schedule": {
          "const": ["primary", "alternate", "primary", "alternate", "primary"]
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "class",
        "family",
        "lineage",
        "declared_capabilities"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "class": {"enum": ["benign", "adversarial"]},
        "family": {"$ref": "#/$defs/id"},
        "lineage": {"$ref": "#/$defs/id"},
        "declared_capabilities": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/capability"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"class": {"const": "benign"}},
            "required": ["class"]
          },
          "then": {"properties": {"family": {"const": "benign"}}},
          "else": {"properties": {"family": {"not": {"const": "benign"}}}}
        }
      ]
    }
  }
}
