{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aragorn.dev/schema/policy-v2.schema.json",
  "title": "Aragorn admission policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "required_analyzers",
    "hard_deny_reason_codes",
    "review_severities",
    "allowed_artifact_graph_profiles"
  ],
  "properties": {
    "schema": {
      "const": "aragorn/policy/v2"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "required_analyzers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "hard_deny_reason_codes": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reason_code"
      }
    },
    "review_severities": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "info",
          "low",
          "medium",
          "high",
          "critical"
        ]
      }
    },
    "allowed_artifact_graph_profiles": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact_graph_profile"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_:.-]{0,255}$"
    },
    "artifact_graph_profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/v[1-9][0-9]{0,8}$"
    }
  }
}
