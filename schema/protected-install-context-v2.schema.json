{
  "$id": "https://aragorn.dev/schema/protected-install-context-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aragorn protected install context v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "context_id",
    "status",
    "expires_at_unix",
    "operation",
    "expected_active",
    "decision_digest",
    "manifest_digest",
    "artifact_graph_digest",
    "policy_digest",
    "analyzer_run_receipt_digests",
    "analyzer_verifier_digest",
    "artifact_graph_verifier_digest",
    "target_runtime_digest",
    "runtime_conformance_digest",
    "destination"
  ],
  "properties": {
    "schema": {"const": "aragorn/protected-install-context/v2"},
    "authority": {
      "const": "BROKER_CONTEXT_ONLY_NOT_INSTALLER_AUTHORITY"
    },
    "context_id": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["active", "revoked"]},
    "expires_at_unix": {"type": "integer", "minimum": 0},
    "operation": {"enum": ["install", "update", "rollback"]},
    "expected_active": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/expectedActive"}
      ]
    },
    "decision_digest": {"$ref": "#/$defs/digest"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "artifact_graph_digest": {"$ref": "#/$defs/digest"},
    "quarantine_receipt_digest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/digest"}
      ]
    },
    "gateway_profile_digest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/digest"}
      ]
    },
    "policy_digest": {"$ref": "#/$defs/digest"},
    "analyzer_run_receipt_digests": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "analyzer_verifier_digest": {"$ref": "#/$defs/digest"},
    "artifact_graph_verifier_digest": {"$ref": "#/$defs/digest"},
    "target_runtime_digest": {"$ref": "#/$defs/digest"},
    "runtime_conformance_digest": {"$ref": "#/$defs/digest"},
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_device", "root_inode", "target_name"],
      "properties": {
        "root_device": {"type": "integer", "minimum": 0},
        "root_inode": {"type": "integer", "minimum": 1},
        "target_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        }
      }
    }
  },
  "dependentRequired": {
    "quarantine_receipt_digest": ["gateway_profile_digest"],
    "gateway_profile_digest": ["quarantine_receipt_digest"]
  },
  "allOf": [
    {
      "if": {
        "properties": {"operation": {"const": "install"}},
        "required": ["operation"]
      },
      "then": {
        "properties": {"expected_active": {"type": "null"}}
      },
      "else": {
        "properties": {
          "expected_active": {"$ref": "#/$defs/expectedActive"}
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "expectedActive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "manifest_digest"],
      "properties": {
        "context_id": {"$ref": "#/$defs/digest"},
        "manifest_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
