{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aragorn.dev/schema/runtime-action-worker-activation-expiry-systemd-qualification-v1.schema.json",
  "title": "Aragorn bounded worker activation and expiry qualification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assurance",
    "bindings",
    "cases",
    "decision",
    "limitations",
    "source_recorded_at"
  ],
  "properties": {
    "schema": {
      "const": "aragorn/runtime-action-worker-activation-expiry-systemd-qualification/v1"
    },
    "assurance": {
      "const": "SEMANTICALLY_REPLAY_VERIFIED_PINNED_ACTIVATION_EXPIRY_ROTATION_AND_CONSUMED_ACTION_EVIDENCE"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation",
        "grants",
        "harness",
        "implementation",
        "parent_qualification",
        "runtime",
        "source_observation"
      ],
      "properties": {
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gateway_config_digest",
            "lock_path",
            "unit_fragment_digests",
            "worker_binding_digest"
          ],
          "properties": {
            "gateway_config_digest": {"$ref": "#/$defs/digest"},
            "lock_path": {
              "const": "/run/lock/aragorn-runtime-capability-activation.lock"
            },
            "unit_fragment_digests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "aragorn-agent-gateway.service",
                "aragorn-runtime-action-worker.service",
                "aragorn-runtime-lineage-capability-action-broker.service",
                "aragorn-runtime-lineage-capability-observation-publisher.service"
              ],
              "properties": {
                "aragorn-agent-gateway.service": {"$ref": "#/$defs/digest"},
                "aragorn-runtime-action-worker.service": {"$ref": "#/$defs/digest"},
                "aragorn-runtime-lineage-capability-action-broker.service": {
                  "$ref": "#/$defs/digest"
                },
                "aragorn-runtime-lineage-capability-observation-publisher.service": {
                  "$ref": "#/$defs/digest"
                }
              }
            },
            "worker_binding_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "grants": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expired_archive_digest",
            "expired_state_digest",
            "final_consumed_state_digest",
            "fresh_grant_digest",
            "short_grant_digest"
          ],
          "properties": {
            "expired_archive_digest": {"$ref": "#/$defs/digest"},
            "expired_state_digest": {"$ref": "#/$defs/digest"},
            "final_consumed_state_digest": {"$ref": "#/$defs/digest"},
            "fresh_grant_digest": {"$ref": "#/$defs/digest"},
            "short_grant_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "child_image_id",
            "harness_digest",
            "image_lineage_digest",
            "parent_image_id",
            "source_commit"
          ],
          "properties": {
            "child_image_id": {"$ref": "#/$defs/digest"},
            "harness_digest": {"$ref": "#/$defs/digest"},
            "image_lineage_digest": {"$ref": "#/$defs/digest"},
            "parent_image_id": {"$ref": "#/$defs/digest"},
            "source_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capture_recipe_digest",
            "dockerfile_digest",
            "driver_digest",
            "installed_closure_digest",
            "probe_digest",
            "verifier_implementation_digest",
            "worker_installer_digest"
          ],
          "properties": {
            "capture_recipe_digest": {"$ref": "#/$defs/digest"},
            "dockerfile_digest": {"$ref": "#/$defs/digest"},
            "driver_digest": {"$ref": "#/$defs/digest"},
            "installed_closure_digest": {"$ref": "#/$defs/digest"},
            "probe_digest": {"$ref": "#/$defs/digest"},
            "verifier_implementation_digest": {"$ref": "#/$defs/digest"},
            "worker_installer_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "parent_qualification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observation",
            "receipt",
            "schema_digest",
            "verifier_digest"
          ],
          "properties": {
            "observation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bytes", "canonical_digest", "path", "raw_digest"],
              "properties": {
                "bytes": {"const": 124214},
                "canonical_digest": {"$ref": "#/$defs/digest"},
                "path": {
                  "const": "benchmark/evidence/runtime-action-worker-openclaw-systemd-composition-p3-7b-2026-08-09.json"
                },
                "raw_digest": {"$ref": "#/$defs/digest"}
              }
            },
            "receipt": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bytes", "canonical_digest", "path", "raw_digest"],
              "properties": {
                "bytes": {"const": 5147},
                "canonical_digest": {"$ref": "#/$defs/digest"},
                "path": {
                  "const": "benchmark/receipts/phase3-runtime-action-worker-openclaw-systemd-qualification-v1-2026-08-09.json"
                },
                "raw_digest": {"$ref": "#/$defs/digest"}
              }
            },
            "schema_digest": {"$ref": "#/$defs/digest"},
            "verifier_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tree_digest", "version", "volume"],
          "properties": {
            "tree_digest": {"$ref": "#/$defs/digest"},
            "version": {"const": "OpenClaw 2026.7.1 (2d2ddc4)"},
            "volume": {"const": "aragorn-openclaw-2026-7-1-runtime"}
          }
        },
        "source_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority",
            "bytes",
            "canonical_digest",
            "path",
            "raw_digest",
            "schema"
          ],
          "properties": {
            "authority": {
              "const": "BOUNDED_ACTIVATION_EXPIRY_ROTATION_OBSERVATION_ONLY_NOT_VERIFIED_RUN_EDR_INSTALLER_RELEASE_AUTHORITY"
            },
            "bytes": {"const": 311385},
            "canonical_digest": {"$ref": "#/$defs/digest"},
            "path": {
              "const": "benchmark/evidence/runtime-action-worker-activation-expiry-systemd-composition-p3-7c-2026-08-09.json"
            },
            "raw_digest": {"$ref": "#/$defs/digest"},
            "schema": {
              "const": "aragorn/runtime-action-worker-activation-expiry-systemd-observation/v1"
            }
          }
        }
      }
    },
    "cases": {
      "const": {
        "coherent_consumed": {
          "driver_status": "COMPLETED",
          "effect_status": "CREATED",
          "grant_state": "CONSUMED",
          "status": "PASS",
          "verdict": "ALLOW"
        },
        "expired_fail_stop": {
          "activation_exit_code": 1,
          "grant_state": "EXPIRED",
          "route_fail_stopped": true,
          "status": "PASS"
        },
        "full_activation": {
          "boot_authority": false,
          "service_state": "FOUR_ACTIVE",
          "status": "PASS"
        },
        "terminal_archive_rotation": {
          "archive_exact": true,
          "status": "PASS",
          "transition": "EXPIRED_TO_AVAILABLE"
        }
      }
    },
    "decision": {
      "const": {
        "aggregate_gate_eligible": false,
        "bounded_activation_expiry_evidence_eligible": true,
        "edr_claim_eligible": false,
        "installer_authority_eligible": false,
        "parent_p3_7b_unchanged": true,
        "phase3_exit_eligible": false,
        "public_release_eligible": false,
        "qualified_pair_retained_evidence_eligible": true,
        "run_01_eligible": false,
        "run_02_eligible": false,
        "source_observation_unchanged": true,
        "source_observation_verified": true,
        "status": "P3_7C_BOUNDED_PASS"
      }
    },
    "limitations": {
      "const": [
        "ONE_LOCAL_PRIVILEGED_DOCKER_SYSTEMD_FIXTURE_ONLY",
        "EXACT_OPENCLAW_2026_7_1_RUNTIME_VOLUME_AND_EVALUATOR_PROVIDER_ONLY",
        "ONE_AVAILABLE_TO_EXPIRED_TRANSITION_ONLY",
        "ONE_OPERATOR_UNMASK_AND_TERMINAL_ARCHIVE_ROTATION_ONLY",
        "ONE_FRESH_GRANT_AND_ONE_CREATE_ACTION_ONLY",
        "EXPIRY_USES_LOCAL_WALL_CLOCK_WITHOUT_EXTERNAL_TIME_ATTESTATION",
        "NO_CLOCK_STEP_SLEW_ROLLBACK_OR_EXPIRY_LATENCY_QUALIFICATION",
        "NO_REBOOT_SYSTEMD_REEXEC_BOOT_ACTIVATION_OR_CREDENTIAL_REPROJECTION",
        "NO_SIGKILL_POWER_LOSS_OR_FILESYSTEM_DURABILITY_FAULT_INJECTION",
        "NO_AUTOMATIC_CONTINUOUS_REPEATED_OR_OVERLAPPING_GRANT_RENEWAL",
        "NO_CONCURRENT_ACTIVATION_LOCK_CONTENTION_OR_PARTIAL_SYSTEMCTL_FAILURE",
        "NO_CLAIMED_CONNECTION_ACROSS_EXPIRY_QUALIFICATION",
        "NO_NATIVE_HOST_VM_HOSTILE_ROOT_OR_SAME_UID_DIRECTORY_ATTESTATION",
        "SOURCE_COMMIT_SIGNATURE_TRUSTS_LOCAL_GIT_CONFIGURATION_AND_KEYRING",
        "CONTAINER_BUILD_AND_CAPTURE_TOOLCHAIN_NOT_INDEPENDENTLY_ATTESTED",
        "PYTHON_NODE_SYSTEMD_KERNEL_AND_NATIVE_DEPENDENCY_CLOSURE_NOT_FULLY_PINNED",
        "PROVIDER_AND_OPENCLAW_SESSION_RAW_BYTES_NOT_RETAINED",
        "P3_7B_PARENT_REMAINS_SEPARATE_IMMUTABLE_QUALIFICATION",
        "SYSCALL_CAUSATION_IS_PINNED_IMPLEMENTATION_BOUND_NOT_INDEPENDENT_ATTESTATION",
        "TRACE_PROVES_ONE_ROUTE_CONNECT_WITHOUT_RETRY_NOT_APPLICATION_SEND_COUNT",
        "PYTHON_STDLIB_AND_DYNAMIC_VERIFIER_DEPENDENCY_CLOSURE_NOT_PINNED",
        "RUN_01_NOT_ESTABLISHED",
        "RUN_02_NOT_ESTABLISHED",
        "PHASE_3_EXIT_NOT_ESTABLISHED",
        "EDR_CLAIM_NOT_ESTABLISHED",
        "INSTALLER_AUTHORITY_NOT_ESTABLISHED",
        "PUBLIC_RELEASE_NOT_AUTHORIZED"
      ]
    },
    "source_recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
