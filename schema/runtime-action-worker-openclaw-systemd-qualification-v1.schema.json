            "raw_digest": {"$ref": "#/$defs/digest"},
            "schema": {
              "const": "aragorn/runtime-producer-lineage-openclaw-systemd-evidence/v1"
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entrypoint_digest", "tree_digest", "version"],
          "properties": {
            "entrypoint_digest": {"$ref": "#/$defs/digest"},
            "tree_digest": {"$ref": "#/$defs/digest"},
            "version": {"const": "OpenClaw 2026.7.1 (2d2ddc4)"}
