{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aragorn.dev/schema/runtime-action-worker-openclaw-systemd-qualification-v1.schema.json",
  "title": "Aragorn bounded OpenClaw distinct-worker qualification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assurance",
    "bindings",
    "cases",
    "decision",
    "limitations",
    "source_recorded_at"
  ],
  "properties": {
    "schema": {
      "const": "aragorn/runtime-action-worker-openclaw-systemd-qualification/v1"
    },
    "assurance": {
      "const": "SEMANTICALLY_REPLAY_VERIFIED_PINNED_DISTINCT_WORKER_TRACE_AND_EFFECT_EVIDENCE"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness",
        "implementation",
        "parent_evidence",
        "runtime",
        "source_observation",
        "worker"
      ],
      "properties": {
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["document_digest", "image_id", "parent_image_id"],
          "properties": {
            "document_digest": {"$ref": "#/$defs/digest"},
            "image_id": {"$ref": "#/$defs/digest"},
            "parent_image_id": {"$ref": "#/$defs/digest"}
          }
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_installer_digest",
            "capture_recipe_digest",
            "dockerfile_digest",
            "driver_digest",
            "installer_digest",
            "installed_closure_digest",
            "parent_probe_digest",
            "plugin_digest",
            "probe_digest",
            "verifier_implementation_digest"
