        },
        "source_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority",
            "bytes",
            "canonical_digest",
            "path",
            "raw_digest",
            "schema"
          ],
          "properties": {
            "authority": {
              "const": "BOUNDED_DISTINCT_GATEWAY_RUNTIME_WORKER_OBSERVATION_ONLY_NOT_VERIFIED_RETAINED_EVIDENCE_OR_RUN_EDR_RELEASE_AUTHORITY"
            },
            "bytes": {"const": 124214},
            "canonical_digest": {"$ref": "#/$defs/digest"},
            "path": {
              "const": "benchmark/evidence/runtime-action-worker-openclaw-systemd-composition-p3-7b-2026-08-09.json"
            },
            "raw_digest": {"$ref": "#/$defs/digest"},
            "schema": {
              "const": "aragorn/runtime-action-worker-openclaw-systemd-observation/v1"
