        "parent_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bytes",
            "canonical_digest",
            "path",
            "raw_digest",
            "schema"
          ],
          "properties": {
            "bytes": {"const": 530696},
            "canonical_digest": {"$ref": "#/$defs/digest"},
            "path": {
              "const": "benchmark/evidence/runtime-producer-lineage-openclaw-systemd-composition-p3-6b-2026-08-07.json"
