          "properties": {
            "base_installer_digest": {"$ref": "#/$defs/digest"},
            "capture_recipe_digest": {"$ref": "#/$defs/digest"},
            "dockerfile_digest": {"$ref": "#/$defs/digest"},
            "driver_digest": {"$ref": "#/$defs/digest"},
            "installer_digest": {"$ref": "#/$defs/digest"},
